# Пример конфигурации. Скопируйте этот файл в .env и вставьте свой ключ.
# ВНИМАНИЕ: файл .env с реальным ключом НЕ коммитится в Git (он указан в .gitignore).

# Провайдер модели: gemini (по умолчанию) | openai | ollama
LLM_PROVIDER=gemini

# Google Gemini API — бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Модель, на которой проверялся агент. Если у вас её нет, можно указать другую из списка в AI Studio
GEMINI_MODEL=gemini-3.8-flash
# Резервные модели (через запятую): если основная перегружена (503), запрос СРАЗУ уходит на резервную,
# а основная пропускается около минуты и затем снова получает запросы первой. Недоступные (404) и
# исчерпавшие дневной лимит модели исключаются до конца прогона. Пусто = встроенный список.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Пауза между запросами к ОДНОЙ модели (сек) — чтобы не упираться в лимит бесплатного тарифа (~10 запросов/мин)
REQUEST_INTERVAL_SEC=6
# Сколько независимых запросов к модели выполнять одновременно (1 — строго по очереди)
PARALLEL_REQUESTS=4
# Сколько требований проверять за один запрос к модели
BATCH_SIZE=8

# Либо другие провайдеры (по выбору команды):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Локальные модели (Ollama):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ---- Приём документа и OCR (всё необязательно; значения по умолчанию подходят) ----
# Лимиты: если документ больше — отчёт честно покажет, что часть не проверена
# MAX_INPUT_MB=50
# MAX_PAGES=200
# OCR для сканов: auto — использовать, если установлен; off — не использовать
# OCR_ENABLED=auto
# OCR_LANGUAGES=rus+eng
# OCR_DPI=300
# OCR_PAGE_TIMEOUT_SEC=60
# Путь к программе Tesseract, если её не видно автоматически (Windows):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Пароль для защищённого PDF (только если вам его законно передали):
# PDF_PASSWORD=

# Только основная модель: при перегрузке ждать её, а не переходить на резервные (или флаг --primary-only)
# GEMINI_PRIMARY_ONLY=1
