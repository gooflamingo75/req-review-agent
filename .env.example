# Пример конфигурации. Скопируйте этот файл в .env и вставьте свой ключ.
# ВНИМАНИЕ: файл .env с реальным ключом НЕ коммитится в Git (он указан в .gitignore).

# Провайдер модели: gemini (по умолчанию) | openai | ollama
LLM_PROVIDER=gemini

# Google Gemini API — бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Модель, на которой проверялся агент. Если у вас её нет, можно указать другую из списка в AI Studio
GEMINI_MODEL=gemini-3.8-flash
# Резервные модели (через запятую): агент переключится на них, если основная перегружена (503),
# недоступна (404) или исчерпан её дневной лимит. Пусто = встроенный список.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-latest

# Пауза между запросами (сек) — чтобы не упираться в лимит бесплатного тарифа (~10 запросов/мин)
REQUEST_INTERVAL_SEC=6
# Сколько требований проверять за один запрос к модели
BATCH_SIZE=8

# Либо другие провайдеры (по выбору команды):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Локальные модели (Ollama):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
